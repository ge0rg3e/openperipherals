{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", ".svelte-kit/**"]
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"@openperipherals/desktop#build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"],
			"cache": false
		},
		"@openperipherals/web#build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**", ".svelte-kit/**"],
			"inputs": ["$TURBO_DEFAULT$", "../../package.json"]
		},
		"dist": {
			"dependsOn": ["build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
